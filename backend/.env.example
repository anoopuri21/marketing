# ---------------------------------------------------------------------------
# RankPilot backend configuration. Copy to backend/.env and fill what you have.
# Everything is optional – the platform runs with rule-based fallbacks without keys.
# ---------------------------------------------------------------------------

APP_NAME=RankPilot
# development | production | test. In production the app refuses to start with the default
# SECRET_KEY (or one shorter than 32 chars) or CORS_ORIGINS=* – generate a key with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
ENVIRONMENT=development
SECRET_KEY=change-me-to-a-long-random-string
# Integration credentials (GSC/GA4 service accounts, social tokens, SerpAPI keys …) are encrypted at rest.
# Optional dedicated key (urlsafe base64, 32 bytes):  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# When empty the key is derived from SECRET_KEY – so rotating SECRET_KEY without ENCRYPTION_KEY invalidates stored credentials.
ENCRYPTION_KEY=
# Per-IP throttles on login (10/min), register (5/5 min) and lead discovery (20/h). In-process; disable only for load tests.
RATE_LIMIT_ENABLED=true
LOG_LEVEL=INFO
PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
# Comma separated list of allowed browser origins, or * for any (development only)
CORS_ORIGINS=*

# SQLite by default. For PostgreSQL: postgresql+asyncpg://user:pass@host:5432/rankpilot (pip install asyncpg)
# DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# --- Crawler ---------------------------------------------------------------
CRAWL_MAX_PAGES=25
CRAWL_TIMEOUT_SECONDS=15
CRAWL_CONCURRENCY=5

# --- AI (pluggable: auto | openai | anthropic | none) ------------------------
AI_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# --- Creatives / social images ----------------------------------------------
# Template graphics always work (Pillow). auto = AI images with OpenAI when OPENAI_API_KEY is set.
IMAGE_PROVIDER=auto
OPENAI_IMAGE_MODEL=gpt-image-1
# Generated creatives, uploads and logos; served by the API at /media/... (default: backend/data/media)
# Social networks download post images from PUBLIC_BASE_URL + /media/..., so set PUBLIC_BASE_URL to a public https URL in production.
# MEDIA_DIR=/var/lib/rankpilot/media

# --- Google rank tracking (auto | serpapi | none) ----------------------------
SERP_PROVIDER=auto
SERPAPI_KEY=

# --- Lead finder (auto | serpapi | demo | none) -------------------------------
# auto = real businesses from Google Maps / Google Search via SerpAPI when SERPAPI_KEY is set,
# otherwise clearly-labelled demo prospects (example.com) so the pipeline can be tried without keys.
LEAD_PROVIDER=auto
# Pages crawled per prospect for the mini audit, and background qualifications per scheduler tick
LEAD_QUALIFY_MAX_PAGES=3
LEAD_QUALIFY_PER_TICK=3

# --- Email (auto | smtp | file | console) -----------------------------------
# auto = smtp when SMTP_HOST is set, otherwise saves .eml/.html files to data/outbox
EMAIL_BACKEND=auto
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=RankPilot Reports <reports@yourdomain.com>
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# --- Scheduler -------------------------------------------------------------
SCHEDULER_ENABLED=true
SCHEDULER_TICK_SECONDS=60
AUTO_AUDIT_INTERVAL_DAYS=7
# How often connected Google Search Console / GA4 integrations refresh (also refreshed before every report)
INTEGRATION_SYNC_INTERVAL_HOURS=24
